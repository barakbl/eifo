# TVIL secrets and machine-specific settings - copy to .env and fill in.
# Everything here can also be exported as a real environment variable.
# These override config/tvil.toml.

# --- Required to run the fetcher (S1+) -------------------------------------
# Free key from https://www.themoviedb.org/settings/api
TVIL_TMDB_API_KEY=

# --- Required to run the API with login (S5+) ------------------------------
# 32+ random bytes, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
TVIL_SECRET_KEY=

TVIL_GOOGLE_CLIENT_ID=
TVIL_GOOGLE_CLIENT_SECRET=
TVIL_X_CLIENT_ID=
TVIL_X_CLIENT_SECRET=

# --- Optional overrides ----------------------------------------------------
# TVIL_DB_URL=sqlite:///data/tvil.db
# TVIL_IMAGES_DIR=data/images
# TVIL_PUBLIC_ORIGIN=https://tvil.example.com
# TVIL_CONFIG_FILE=config/tvil.toml
