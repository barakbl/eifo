  "title": "Eifo · Plugins",
  "description": "Every plugin run, from whichever machine ran it: how it ended, how long it took, and what each service holds.",
  "tags": [
    "eifo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
