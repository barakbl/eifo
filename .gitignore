# Runtime state - never committed
data/
# The local config and any backup of it. A deployment's own settings are
# nobody else's business, and a hand-made copy called .bak or .before-something
# is the same file with a different name.
config/eifo.toml
config/eifo.toml.*
.env
.env.bak

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local-only files: private notes, scratch configs, anything ending .local
*.local

# The monitoring stack's own secrets and scratch, wherever it runs
monitoring/.env
monitoring/secrets/
monitoring/history/
