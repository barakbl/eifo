    {
      "id": 9,
      "type": "timeseries",
      "title": "Runs that did not end well, per day",
      "description": "Failed, crashed and aborted runs, by plugin.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
