# Eifo secrets and machine-specific settings - copy to .env and fill in.
# Everything here can also be exported as a real environment variable.
# These override config/eifo.toml.

# --- Required to run the fetcher (S1+) -------------------------------------
# Free key from https://www.themoviedb.org/settings/api
EIFO_TMDB_API_KEY=

# --- Required to run the API with login (S5+) ------------------------------
# 32+ random bytes, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
EIFO_SECRET_KEY=

EIFO_GOOGLE_CLIENT_ID=
EIFO_GOOGLE_CLIENT_SECRET=
EIFO_X_CLIENT_ID=
EIFO_X_CLIENT_SECRET=

# --- Optional overrides ----------------------------------------------------
# EIFO_DB_URL=sqlite:///data/eifo.db
# EIFO_IMAGES_DIR=data/images
# EIFO_PUBLIC_ORIGIN=https://eifo.example.com
# EIFO_CONFIG_FILE=config/eifo.toml
# The API brings the schema to head as it starts; set 0 to keep migrations
# a separate, deliberate step (it then refuses to start unmigrated).
# EIFO_AUTO_MIGRATE=0

# --- Docker only -----------------------------------------------------------
# Build the image without the headless Chromium (only the `kan` source needs it).
# EIFO_INSTALL_BROWSER=0
