    {
      "id": 7,
      "type": "table",
      "title": "Plugins",
      "description": "One row per plugin. 'Failed in range' and 'Average run' cover the selected time range; the rest describe the latest run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) (((eifo_fetch_last_run_ok) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace(eifo_fetch_last_run_ok, \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) (((eifo_fetch_last_run_end_timestamp_seconds * 1000) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace(eifo_fetch_last_run_end_timestamp_seconds * 1000, \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) (((eifo_fetch_last_run_duration_seconds) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace(eifo_fetch_last_run_duration_seconds, \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) (((eifo_fetch_last_run_errors) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace(eifo_fetch_last_run_errors, \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) ((((sum by (phase, source) (eifo_fetch_runs_total{status!=\"ok\"}) - sum by (phase, source) ((eifo_fetch_runs_total{status!=\"ok\"} offset $__range) or (eifo_fetch_runs_total{status!=\"ok\"} * 0))) / ((sum by (phase, source) (eifo_fetch_runs_total) - sum by (phase, source) ((eifo_fetch_runs_total offset $__range) or (eifo_fetch_runs_total * 0))) > 0)) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace((sum by (phase, source) (eifo_fetch_runs_total{status!=\"ok\"}) - sum by (phase, source) ((eifo_fetch_runs_total{status!=\"ok\"} offset $__range) or (eifo_fetch_runs_total{status!=\"ok\"} * 0))) / ((sum by (phase, source) (eifo_fetch_runs_total) - sum by (phase, source) ((eifo_fetch_runs_total offset $__range) or (eifo_fetch_runs_total * 0))) > 0), \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) ((((sum by (phase, source) (eifo_fetch_run_seconds_total) - sum by (phase, source) ((eifo_fetch_run_seconds_total offset $__range) or (eifo_fetch_run_seconds_total * 0))) / ((sum by (phase, source) (eifo_fetch_runs_total) - sum by (phase, source) ((eifo_fetch_runs_total offset $__range) or (eifo_fetch_runs_total * 0))) > 0)) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace((sum by (phase, source) (eifo_fetch_run_seconds_total) - sum by (phase, source) ((eifo_fetch_run_seconds_total offset $__range) or (eifo_fetch_run_seconds_total * 0))) / ((sum by (phase, source) (eifo_fetch_runs_total) - sum by (phase, source) ((eifo_fetch_runs_total offset $__range) or (eifo_fetch_runs_total * 0))) > 0), \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) (((label_replace(eifo_sync_last_items_seen, \"phase\", \"sync\", \"\", \"\")) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace(label_replace(eifo_sync_last_items_seen, \"phase\", \"sync\", \"\", \"\"), \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) (((label_replace(sum by (source) (eifo_source_titles{type=\"movie\"}), \"phase\", \"sync\", \"\", \"\")) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace(label_replace(sum by (source) (eifo_source_titles{type=\"movie\"}), \"phase\", \"sync\", \"\", \"\"), \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (phase, source, name) (((label_replace(sum by (source) (eifo_source_titles{type=\"series\"}), \"phase\", \"sync\", \"\", \"\")) * on (source) group_left (name) eifo_source_info) or on (phase, source) label_replace(label_replace(sum by (source) (eifo_source_titles{type=\"series\"}), \"phase\", \"sync\", \"\", \"\"), \"name\", \"$1\", \"source\", \"(.*)\"))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        }
      ],
