      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(eifo_http_request_duration_seconds_bucket{route!~\"static|/api/v1/metrics|/api/v1/monitoring/gate|/api/v1/ingest/.*\"}[1h])))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
